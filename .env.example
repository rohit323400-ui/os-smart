# =================================================================
# 🏢 RAAH NAGAR OS - PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================
# Use this template for your production .env configuration.
# In production (NODE_ENV=production), strict validation applies:
# - JWT_SECRET must be explicitly defined and secure.
# - IOT_GATEWAY_KEY must be securely defined for hardware ingestion.
# - ALLOWED_ORIGINS must specify only verified HTTPS domains.
# =================================================================

# 1. SERVER CONFIGURATION
PORT=5000
NODE_ENV=production

# 2. REVERSE PROXY & PRODUCTION CORS WHITELIST
# In production, only HTTPS origins are permitted. Localhost and private LAN IPs are rejected.
ALLOWED_ORIGINS=https://society.yourdomain.com,https://admin.yourdomain.com

# 3. MYSQL PRIMARY DATABASE (Absolute Source of Truth: raah_nagar_db)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=society_admin
DB_PASSWORD=your_secure_db_password_here
DB_NAME=raah_nagar_db

# 4. AUTHENTICATION & JWT SECURITY (Mandatory in Production)
# Generate a cryptographically strong 256-bit key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_256_bit_jwt_secret_here

# 5. IOT HARDWARE GATEWAY SECURITY (Mandatory in Production)
# Secret key used by physical IoT Edge Gateways to authenticate against /api/iot/gateway/telemetry
IOT_GATEWAY_KEY=your_secure_iot_gateway_secret_key_here

# 6. REAL SMTP EMAIL DISPATCH (Native TLS/Net Socket Dialog)
# Emails are never marked delivered without actual SMTP server confirmation.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM=RAAH NAGAR Emergency Desk <alerts@yourdomain.com>

# 7. REAL CARRIER SMS DISPATCH (Optional - Fast2SMS or Twilio)
SMS_PROVIDER=FAST2SMS
SMS_API_KEY=your_fast2sms_api_key_here

# Twilio Configuration (if SMS_PROVIDER=TWILIO)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# 8. DISTRIBUTED MULTI-INSTANCE RATE LIMITING (Optional)
# For multi-node clustering behind Nginx/HAProxy load balancers.
# If omitted, single-instance in-memory limiter is active.
# REDIS_URL=redis://127.0.0.1:6379

# 9. GOOGLE GEMINI AI (Advisory & Consumption Analysis Only)
# Protected deterministic controls: AI never directly operates physical actuators.
GEMINI_API_KEY=your_gemini_api_key_here

# 10. FRONTEND CLIENT CONFIGURATION (Vite Client Environment)
# In production behind Nginx/Caddy on same origin, keep empty or set relative '/api'
# VITE_API_URL=https://society.yourdomain.com/api
# VITE_WS_URL=wss://society.yourdomain.com/ws
