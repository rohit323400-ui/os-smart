# =================================================================
# 🏢 COMMUNITY BRAIN - BACKEND ENVIRONMENT CONFIGURATION
# =================================================================
# Paste your API keys and Database URIs below.
# The server will automatically detect and enable features when keys are provided!

# 1. SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# 2. GOOGLE GEMINI AI (Smart Building Brain AI Engine)
# Get your free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. MONGODB DATABASE (Optional - Falls back to data.json if empty)
# Get a free cluster at: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_society?retryWrites=true&w=majority

# 4. MYSQL / POSTGRESQL CONFIGURATION (Optional - for relational enterprise DBs)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smart_society_db

# 5. FIREBASE / PUSH NOTIFICATIONS (Optional - for emergency SMS & mobile push)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# 6. AUTHENTICATION & SECURITY
JWT_SECRET=super_secret_society_jwt_key_2026
